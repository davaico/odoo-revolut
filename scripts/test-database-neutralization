#!/usr/bin/env bash
# Install after native Odoo neutralization, before any addon cleanup can run.
set -euo pipefail
repository_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
export ODOO_REVOLUT_ODOO_MAJOR=18
source "$repository_root/scripts/odoo-runtime"
project_name="${ODOO_REVOLUT_TEST_PROJECT:-odoo-revolut-neutralization}"
compose_file="${ODOO_REVOLUT_COMPOSE_FILE:-$repository_root/compose.yaml}"
compose=(docker compose --project-name "$project_name" --file "$compose_file")
export ODOO_REVOLUT_ADDONS_DIR="$repository_root"
database_name=odoo_revolut_neutralized_install
cleanup() {
    "${compose[@]}" down --volumes --remove-orphans >/dev/null 2>&1 || true
}
trap cleanup EXIT
cleanup
"${compose[@]}" build odoo
installed_version="$("${compose[@]}" run --rm --no-deps --entrypoint dpkg-query odoo \
    --show --showformat='${Version}' odoo)"
if [[ "$installed_version" != "$ODOO_REVOLUT_ODOO_VERSION" ]]; then
    echo "Expected Odoo $ODOO_REVOLUT_ODOO_VERSION, found $installed_version" >&2
    exit 1
fi
"${compose[@]}" run --rm --no-deps --entrypoint python3 odoo \
    /opt/odoo-test-guard/verify_merchant_http_guard.py
"${compose[@]}" up --detach --wait db
run_odoo() {
    "${compose[@]}" run --rm odoo --database "$database_name" \
        --stop-after-init --workers 0 --max-cron-threads 0 --log-level warn "$@"
}
shell_phase() {
    "${compose[@]}" run --rm -T --entrypoint odoo odoo shell \
        --database "$database_name" --db_host db --db_user odoo --db_password odoo \
        --no-http --max-cron-threads 0 --shell-interface python --log-level warn
}
run_odoo --init point_of_sale,pos_restaurant
"${compose[@]}" run --rm --entrypoint odoo odoo neutralize \
    --database "$database_name" --db_host db --db_user odoo --db_password odoo \
    --addons-path /mnt/extra-addons
shell_phase <<'PY'
assert env['ir.config_parameter'].get_param('database.is_neutralized')
assert env['ir.module.module'].search([('name', '=', 'pos_revolut')]).state == 'uninstalled'
env.cr.execute("SELECT to_regclass('pos_revolut_merchant_credential')")
assert env.cr.fetchone() == (None,)
env['ir.config_parameter'].set_param('pos_revolut.fixture.neutralized_before_install', True)
env.cr.commit()
print('NEUTRALIZED_BEFORE_INSTALL: no addon tables or cleanup')
PY
run_odoo --init pos_revolut
shell_phase < "$repository_root/pos_revolut/tests/neutralized_install_verify.py"
echo "First-install neutralization fixture passed"
