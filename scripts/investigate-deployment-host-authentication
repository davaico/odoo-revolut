#!/usr/bin/env python3
"""Ticket 32 evidence fixture; SSH/SFTP only to an ephemeral loopback server.

Requires the investigation environment's Paramiko, never the deployment runtime.
No remote deployer is executed, no client key/agent is used, and no host key is
written outside the temporary directory. This does not simulate a tailnet.
"""

import argparse
import importlib.machinery
import importlib.util
import io
import json
import logging
import re
import socket
import subprocess
import tempfile
import threading
from pathlib import Path

import paramiko


ROOT = Path(__file__).resolve().parents[1]


class FixtureServer(paramiko.ServerInterface):
    def __init__(self, evidence):
        self.evidence = evidence
        self.exec_ready = threading.Event()

    def check_auth_none(self, username):
        self.evidence["authentications"] += 1
        return paramiko.AUTH_SUCCESSFUL

    def check_channel_request(self, kind, channel_id):
        if kind == "session":
            return paramiko.OPEN_SUCCEEDED
        return paramiko.OPEN_FAILED_ADMINISTRATIVELY_PROHIBITED

    def check_channel_exec_request(self, channel, command):
        self.exec_ready.set()
        return True


class UploadHandle(paramiko.SFTPHandle):
    def __init__(self, evidence):
        super().__init__()
        self.writefile = io.BytesIO()
        self.evidence = evidence

    def chattr(self, attr):
        return paramiko.SFTP_OK  # Metadata is irrelevant for an in-memory upload.

    def close(self):
        self.evidence["uploaded_bytes"] += len(self.writefile.getvalue())
        return super().close()


class FixtureSFTP(paramiko.SFTPServerInterface):
    def __init__(self, server, *, evidence):
        super().__init__(server)
        self.evidence = evidence

    def stat(self, path):
        return paramiko.SFTP_NO_SUCH_FILE

    def open(self, path, flags, attr):
        return UploadHandle(self.evidence)


class FixtureSFTPSubsystem(paramiko.SFTPServer):
    def finish_subsystem(self):
        self.sock.send_exit_status(0)
        super().finish_subsystem()


class LoopbackHost:
    def __init__(self, revision):
        self.key = paramiko.RSAKey.generate(2048)
        self.revision = revision
        self.evidence = {"authentications": 0, "uploaded_bytes": 0, "script_bytes": 0}
        self.errors = []
        self.stopped = threading.Event()
        self.listener = socket.socket()
        self.listener.bind(("127.0.0.1", 0))
        self.listener.listen(2)
        self.listener.settimeout(0.2)
        self.port = self.listener.getsockname()[1]
        self.thread = threading.Thread(target=self.serve, daemon=True)
        self.thread.start()

    def serve(self):
        while not self.stopped.is_set():
            try:
                connection, _address = self.listener.accept()
            except socket.timeout:
                continue
            except OSError:
                break
            transport = paramiko.Transport(connection)
            transport.add_server_key(self.key)
            transport.set_subsystem_handler(
                "sftp", FixtureSFTPSubsystem, FixtureSFTP, evidence=self.evidence,
            )
            server = FixtureServer(self.evidence)
            try:
                transport.start_server(server=server)
                channel = transport.accept(5)
                if channel is None:
                    continue  # A changed host key is rejected before authentication.
                channel.settimeout(5)
                while transport.is_active() and not self.stopped.is_set():
                    if server.exec_ready.wait(0.05):
                        # Read the script as data. Deliberately never execute it.
                        while True:
                            block = channel.recv(65536)
                            if not block:
                                break
                            self.evidence["script_bytes"] += len(block)
                        channel.sendall(f"Deployed POS Revolut revision {self.revision}\n".encode())
                        channel.send_exit_status(0)
                        channel.close()
                        break
            except (EOFError, paramiko.SSHException) as error:
                # Client abort during key verification is an expected observation.
                if self.evidence["authentications"]:
                    self.errors.append(str(error))
            except Exception as error:
                self.errors.append(repr(error))
            finally:
                transport.close()

    def close(self):
        self.stopped.set()
        self.listener.close()
        self.thread.join(6)
        if self.thread.is_alive() or self.errors:
            raise RuntimeError(f"Fixture server failed: {self.errors}")


class IsolatedRunner:
    def __init__(self, config, target):
        self.config = config
        self.target = target

    def run(self, command, **kwargs):
        if command[:3] == ["git", "status", "--porcelain"]:
            # The report/fixture may be uncommitted; cleanliness is covered by
            # existing deployment tests and is not part of this experiment.
            return subprocess.CompletedProcess(command, 0, stdout="", stderr="")
        if command[0] in {"ssh", "scp"}:
            if not any(arg == self.target or arg.startswith(self.target + ":") for arg in command):
                raise RuntimeError("Fixture refused an unexpected target")
            command = [command[0], "-F", str(self.config), *command[1:]]
        elif command[0] != "git":
            raise RuntimeError("Fixture refused an unexpected command")
        return subprocess.run(command, check=True, text=True, timeout=15, **kwargs)


def observe(deployer, revision, case):
    hostname = "wrong.fixture.invalid" if case == "wrong-approved-target" else "approved.fixture.invalid"
    target = "root@" + hostname
    host = LoopbackHost(revision)
    try:
        with tempfile.TemporaryDirectory(prefix="ticket-32-host-") as directory:
            root = Path(directory)
            known = root / "known_hosts"
            known.touch()
            if case in {"correctly-pinned", "changed-key", "wrong-approved-target"}:
                key = paramiko.RSAKey.generate(2048) if case == "changed-key" else host.key
                known.write_text(f"{hostname} {key.get_name()} {key.get_base64()}\n")
            config = root / "ssh_config"
            config.write_text(
                f"Host {hostname}\n"
                f"  HostName 127.0.0.1\n  Port {host.port}\n  HostKeyAlias {hostname}\n"
                f"  UserKnownHostsFile {known}\n  GlobalKnownHostsFile /dev/null\n"
                "  IdentityAgent none\n  IdentityFile none\n  ForwardAgent no\n"
                "  PreferredAuthentications none\n  ProxyCommand none\n  ProxyJump none\n"
                "  ControlMaster no\n  ControlPath none\n  VerifyHostKeyDNS no\n"
                "  UpdateHostKeys no\n  CheckHostIP no\n"
            )
            stdout, stderr = io.StringIO(), io.StringIO()
            result = deployer.main(
                ["deploy", "--repository", str(ROOT), "--revision", revision,
                 "--reviewed-ref", revision, "--ssh-target", target,
                 "--database", "fixture_staging", "--customer", "fixture",
                 "--environment", "staging", "--mode", "upgrade"],
                runner=IsolatedRunner(config, target), stdout=stdout, stderr=stderr,
            )
            evidence = dict(host.evidence, case=case, exit=result,
                            reported_success=f"Deployed POS Revolut revision {revision}" in stdout.getvalue(),
                            host_key_recorded=bool(known.read_text()))
            if case == "changed-key":
                assert result == 1 and "Artifact upload failed" in stderr.getvalue(), stderr.getvalue()
                assert "Host key verification failed" in stderr.getvalue(), stderr.getvalue()
                assert host.evidence == {"authentications": 0, "uploaded_bytes": 0, "script_bytes": 0}, evidence
            else:
                assert result == 0 and not stderr.getvalue(), stderr.getvalue()
                assert evidence["reported_success"] and evidence["host_key_recorded"], evidence
                assert evidence["uploaded_bytes"] > 0 and evidence["script_bytes"] > 0, evidence
            return evidence
    finally:
        host.close()


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--revision", required=True, help="Exact local source revision to investigate")
    args = parser.parse_args()
    if not re.fullmatch(r"[0-9a-f]{40}", args.revision):
        parser.error("--revision must be an exact 40-character commit SHA")
    # Load the exact version under investigation rather than the working copy.
    source = subprocess.check_output(
        ["git", "show", f"{args.revision}:scripts/deploy-addon"], cwd=ROOT, text=True,
    )
    with tempfile.TemporaryDirectory(prefix="ticket-32-source-") as directory:
        script = Path(directory) / "deploy-addon"
        script.write_text(source)
        loader = importlib.machinery.SourceFileLoader("ticket32_deployer", str(script))
        spec = importlib.util.spec_from_loader(loader.name, loader)
        deployer = importlib.util.module_from_spec(spec)
        loader.exec_module(deployer)
        # Paramiko reports expected client key-check aborts through logging.
        logging.getLogger("paramiko").setLevel(logging.CRITICAL)
        for case in ("first-seen", "correctly-pinned", "changed-key", "wrong-approved-target"):
            print(json.dumps(observe(deployer, args.revision, case), sort_keys=True), flush=True)


if __name__ == "__main__":
    main()
