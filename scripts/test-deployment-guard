#!/usr/bin/env python3
"""Exercise the deployment preflight SQL against disposable Odoo 19 records."""

import argparse
import os
import importlib.machinery
import importlib.util
import subprocess
from pathlib import Path


ROOT = Path(__file__).resolve().parent.parent
PROJECT = "odoo-revolut-deployment-guard-test"
DATABASE = "odoo_revolut_guard_test"
COMPOSE = ["docker", "compose", "--project-name", PROJECT, "--file", str(ROOT / "compose.yaml")]

SEED = """
from uuid import uuid4
from odoo import Command

method = env['pos.payment.method'].create({
    'name': 'Deployment guard terminal',
    'payment_method_type': 'terminal',
    'use_payment_terminal': 'revolut',
    'revolut_environment': 'sandbox',
    'revolut_location_id': str(uuid4()),
    'revolut_terminal_id': str(uuid4()),
    'revolut_fulfilment_type': 'eat_in',
    'revolut_secret_reference': 'ODOO_REVOLUT_SECRET_TEST_TERMINAL',
})
config = env['pos.config'].create({
    'name': 'Deployment guard POS',
    'payment_method_ids': [Command.link(method.id)],
    'auto_validate_terminal_payment': True,
})
session = env['pos.session'].create({'config_id': config.id, 'state': 'opened'})
common = {
    'payment_method_id': method.id,
    'company_id': config.company_id.id,
    'pos_config_id': config.id,
    'pos_session_id': session.id,
    'amount': 12.34,
    'amount_minor': 1234,
    'currency_id': config.currency_id.id,
    'currency_code': config.currency_id.name,
    'environment': 'sandbox',
    'location_id': method.revolut_location_id,
    'terminal_id': method.revolut_terminal_id,
    'fulfilment_type': 'eat_in',
    'secret_reference': 'ODOO_REVOLUT_SECRET_TEST_TERMINAL',
}
payment_model = env['pos.revolut.payment.operation']
pending = payment_model.create(dict(
    common, order_uuid='11111111-1111-4111-8111-111111111111',
    payment_line_uuid='11111111-1111-4111-8111-111111111112', state='pending',
))
settled = payment_model.create(dict(
    common, order_uuid='22222222-2222-4222-8222-222222222222',
    payment_line_uuid='22222222-2222-4222-8222-222222222223', state='verified',
    revolut_order_id='22222222-2222-4222-8222-222222222224',
    revolut_payment_id='22222222-2222-4222-8222-222222222225',
))
refund = env['pos.revolut.refund.operation'].create({
    'original_operation_id': settled.id,
    'pos_session_id': session.id,
    'order_uuid': '33333333-3333-4333-8333-333333333333',
    'payment_line_uuid': '33333333-3333-4333-8333-333333333334',
    'amount': 12.34,
    'amount_minor': 1234,
    'return_total_minor': 1234,
    'currency_id': config.currency_id.id,
    'financial_snapshot': {'lines': []},
    'state': 'pending',
})
assert pending.deployment_blocking
assert not settled.deployment_blocking
assert refund.deployment_blocking
env.cr.commit()
print('DEPLOYMENT_GUARD_SEED_OK', flush=True)
"""

SETTLE_PAYMENT = """
payment = env['pos.revolut.payment.operation'].search([
    ('order_uuid', '=', '11111111-1111-4111-8111-111111111111'),
], limit=1)
assert payment and payment.state == 'pending'
payment.write({'state': 'verified'})
assert not payment.deployment_blocking
env.cr.commit()
print('DEPLOYMENT_GUARD_PAYMENT_SETTLED', flush=True)
"""

REFERENCE_REFUND = """
refund = env['pos.revolut.refund.operation'].search([
    ('order_uuid', '=', '33333333-3333-4333-8333-333333333333'),
], limit=1)
assert refund and refund.state == 'pending'
refund.write({'revolut_order_id': '33333333-3333-4333-8333-333333333335'})
assert refund.deployment_blocking  # Financial uncertainty remains protected.
env.cr.commit()
print('DEPLOYMENT_GUARD_REFUND_REFERENCE_SAVED', flush=True)
"""

SETTLE_REFUND = """
refund = env['pos.revolut.refund.operation'].search([
    ('order_uuid', '=', '33333333-3333-4333-8333-333333333333'),
], limit=1)
assert refund and refund.state in {'pending', 'unresolved'}
refund.write({'state': 'verified'})
assert not refund.deployment_blocking
env.cr.commit()
print('DEPLOYMENT_GUARD_REFUND_SETTLED', flush=True)
"""

SEED_EXTERNAL = """
source = env['pos.revolut.payment.operation'].search([
    ('order_uuid', '=', '22222222-2222-4222-8222-222222222222'),
], limit=1)
external = env['pos.revolut.refund.operation'].create({
    'origin': 'external', 'original_operation_id': source.id,
    'pos_session_id': source.pos_session_id.id,
    'amount': 0.01, 'amount_minor': 1, 'currency_id': source.currency_id.id,
    'revolut_order_id': '44444444-4444-4444-8444-444444444444', 'state': 'pending',
})
env['pos.revolut.external.refund.evidence'].create({
    'credential_id': source.credential_id.id, 'original_operation_id': source.id,
    'provider_order_id': 'scan-window', 'reason': 'interrupted',
})
assert external.deployment_blocking
env.cr.commit()
"""

SETTLE_EXTERNAL = """
env['pos.revolut.refund.operation'].search([('origin', '=', 'external')]).write({'state': 'verified'})
env['pos.revolut.external.refund.evidence'].search([]).write({'resolved': True})
env.cr.commit()
"""


REFUND_DISPATCHING = """
refund = env['pos.revolut.refund.operation'].search([('origin', '=', 'odoo')], limit=1)
refund.write({'state': 'dispatching'})
env.cr.commit()
"""

REFUND_UNRESOLVED = """
refund = env['pos.revolut.refund.operation'].search([('origin', '=', 'odoo')], limit=1)
refund.write({'state': 'unresolved'})
env.cr.commit()
"""

SEED_MALFORMED_REFUND = """
source = env['pos.revolut.payment.operation'].search([
    ('order_uuid', '=', '22222222-2222-4222-8222-222222222222'),
], limit=1)
env['pos.revolut.refund.operation'].create({
    'original_operation_id': source.id, 'pos_session_id': source.pos_session_id.id,
    'order_uuid': '55555555-5555-4555-8555-555555555555',
    'payment_line_uuid': '55555555-5555-4555-8555-555555555556',
    'amount': 0.01, 'amount_minor': 1, 'return_total_minor': 1,
    'currency_id': source.currency_id.id, 'financial_snapshot': {'lines': []},
    'revolut_order_id': 'invalid-provider-reference', 'state': 'pending',
})
env.cr.commit()
"""

FAIL_MALFORMED_REFUND = """
env['pos.revolut.refund.operation'].search([
    ('revolut_order_id', '=', 'invalid-provider-reference'),
]).write({'state': 'failed'})
env.cr.commit()
"""

POLL_AFTER_UPGRADE = """
import json
import os
from unittest.mock import patch
from requests import Response

refund = env['pos.revolut.refund.operation'].search([('origin', '=', 'external')], limit=1)
assert refund and refund.state == 'pending'
reference, source, count = refund.revolut_order_id, refund.original_operation_id, env['pos.revolut.refund.operation'].search_count([])
observed = []
def provider(method, url, **kwargs):
    assert method == 'GET' and url.endswith('/api/orders/' + reference), (method, url)
    observed.append(method)
    response = Response()
    response.status_code = 200
    response._content = json.dumps({
        'id': reference, 'type': 'refund', 'state': 'completed',
        'related_order_id': source.revolut_order_id, 'amount': refund.amount_minor,
        'currency': refund.currency_id.name,
        'created_at': '2026-10-07T00:00:00.000Z',
    }).encode()
    return response
with patch.dict(os.environ, {'ODOO_REVOLUT_SECRET_TEST_TERMINAL': 'mock-only'}), patch(
    'odoo.addons.pos_revolut.models.pos_payment_method.requests.request', side_effect=provider,
):
    result = refund.payment_method_id.revolut_poll_refund(refund.id)
    repeated = refund.payment_method_id.revolut_poll_refund(refund.id)
assert result == repeated and result['state'] == 'verified'
assert observed == ['GET'], observed
refund.invalidate_recordset()
assert refund.revolut_order_id == reference and refund.original_operation_id == source
assert env['pos.revolut.refund.operation'].search_count([]) == count
print('DEPLOYMENT_PENDING_REFUND_RECOVERED: one GET, no POST, original identity', flush=True)
"""


def run(*args, input_text=None):
    return subprocess.run(
        [*COMPOSE, *args], input=input_text, text=True, check=True,
    )


def shell(source):
    run(
        "run", "--rm", "-T", "--entrypoint", "odoo", "odoo", "shell",
        "--database", DATABASE, "--db_host", "db", "--db_user", "odoo",
        "--db_password", "odoo", "--no-http", "--max-cron-threads", "0",
        "--shell-interface", "python", "--log-level", "warn",
        input_text=source,
    )


class DockerPsqlRunner:
    """Run the production preflight's psql commands on the disposable DB."""

    def run(self, command, **kwargs):
        assert command[:8] == [
            "runuser", "-u", "postgres", "--", "psql", "--dbname", DATABASE,
            "--no-align",
        ], command
        return subprocess.run(
            [*COMPOSE, "exec", "-T", "db", "psql", "--username", "odoo",
             "--dbname", DATABASE, *command[7:]],
            check=True, text=True, **kwargs,
        )


def deployment():
    loader = importlib.machinery.SourceFileLoader(
        "deploy_addon_remote", str(ROOT / "scripts/deploy-addon-remote")
    )
    spec = importlib.util.spec_from_loader(loader.name, loader)
    module = importlib.util.module_from_spec(spec)
    loader.exec_module(module)
    return module.RemoteDeployment(
        runner=DockerPsqlRunner(), root="/", archive="/unused",
        expected_sha256="0" * 64, revision="0" * 40, database=DATABASE,
        customer="test", environment="sandbox", mode="upgrade",
    )


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--legacy-addons-dir", type=Path)
    args = parser.parse_args()
    candidate_addons = os.environ.get("ODOO_REVOLUT_ADDONS_DIR", str(ROOT / "addons"))
    if args.legacy_addons_dir:
        legacy = args.legacy_addons_dir.resolve()
        if not (legacy / "pos_revolut/__manifest__.py").is_file():
            parser.error("Legacy addon directory must contain pos_revolut")
        os.environ["ODOO_REVOLUT_ADDONS_DIR"] = str(legacy)
    run("down", "--volumes", "--remove-orphans")
    try:
        run("build", "odoo")
        run("run", "--rm", "--no-deps", "--entrypoint", "python3", "odoo",
            "/opt/odoo-test-guard/verify_merchant_http_guard.py")
        run("up", "--detach", "--wait", "db")
        run("run", "--rm", "odoo", "--database", DATABASE,
            "--init", "pos_revolut", "--stop-after-init", "--workers", "0",
            "--max-cron-threads", "0", "--log-level", "warn")
        shell(SEED)
        guard = deployment()
        assert guard._financial_blockers() == [
            "pos_revolut_payment_operation=1", "pos_revolut_refund_operation=1",
        ]
        shell(SETTLE_PAYMENT)
        assert guard._financial_blockers() == ["pos_revolut_refund_operation=1"]
        shell(REFERENCE_REFUND)
        assert guard._financial_blockers() == []
        shell(REFUND_DISPATCHING)
        assert guard._financial_blockers() == ["pos_revolut_refund_operation=1"]
        shell(REFUND_UNRESOLVED)
        assert guard._financial_blockers() == []
        shell(SEED_MALFORMED_REFUND)
        assert guard._financial_blockers() == ["pos_revolut_refund_operation=1"]
        shell(FAIL_MALFORMED_REFUND)
        assert guard._financial_blockers() == []
        shell(SEED_EXTERNAL)
        assert guard._financial_blockers() == []
        before = guard._financial_snapshot()
        assert any(row['state'] == 'pending' for row in before['pos_revolut_refund_operation'])
        assert any(row['deployment_blocking'] for row in before['pos_revolut_external_refund_evidence'])
        os.environ["ODOO_REVOLUT_ADDONS_DIR"] = candidate_addons
        run("run", "--rm", "odoo", "--database", DATABASE,
            "--update", "pos_revolut", "--stop-after-init", "--no-http", "--workers", "0",
            "--max-cron-threads", "0", "--log-level", "warn")
        guard._verify_financial_snapshot(before)
        assert guard._financial_blockers() == []
        print("DEPLOYMENT_PENDING_UPGRADE_PRESERVED: states, references, amounts, reservations, evidence", flush=True)
        shell(POLL_AFTER_UPGRADE)
        shell(SETTLE_REFUND)
        shell(SETTLE_EXTERNAL)
        assert guard._financial_blockers() == []
        print("Deployment guard passed: active dispatch blocked; referenced refunds/evidence preserved through upgrade")
    finally:
        run("down", "--volumes", "--remove-orphans")


if __name__ == "__main__":
    main()
