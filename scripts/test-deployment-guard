POLL_AFTER_UPGRADE = """
import json
import os
from unittest.mock import patch
from requests import Response

refund = env['pos.revolut.refund.operation'].search([('origin', '=', 'external')], limit=1)
assert refund and refund.state == 'pending'
reference, source, count = refund.revolut_order_id, refund.original_operation_id, env['pos.revolut.refund.operation'].search_count([])
observed = []
def provider(method, url, **kwargs):
    assert method == 'GET' and url.endswith('/api/orders/' + reference), (method, url)
    observed.append(method)
    response = Response()
    response.status_code = 200
    response._content = json.dumps({
        'id': reference, 'type': 'refund', 'state': 'completed',
        'related_order_id': source.revolut_order_id, 'amount': refund.amount_minor,
        'currency': refund.currency_id.name,
        'created_at': '2026-10-07T00:00:00.000Z',
    }).encode()
    return response
with patch.dict(os.environ, {'ODOO_REVOLUT_SECRET_TEST_TERMINAL': 'mock-only'}), patch(
    'odoo.addons.pos_revolut.models.pos_payment_method.requests.request', side_effect=provider,
):
    result = refund.payment_method_id.revolut_poll_refund(refund.id)
    repeated = refund.payment_method_id.revolut_poll_refund(refund.id)
assert result == repeated and result['state'] == 'verified'
assert observed == ['GET'], observed
refund.invalidate_recordset()
assert refund.revolut_order_id == reference and refund.original_operation_id == source
assert env['pos.revolut.refund.operation'].search_count([]) == count
print('DEPLOYMENT_PENDING_REFUND_RECOVERED: one GET, no POST, original identity', flush=True)
"""


def run(*args, input_text=None):
    return subprocess.run(
        [*COMPOSE, *args], input=input_text, text=True, check=True,
    )


def shell(source):
    run(
        "run", "--rm", "-T", "--entrypoint", "odoo", "odoo", "shell",
        "--database", DATABASE, "--db_host", "db", "--db_user", "odoo",
        "--db_password", "odoo", "--no-http", "--max-cron-threads", "0",
        "--shell-interface", "python", "--log-level", "warn",
        input_text=source,
    )


class DockerPsqlRunner:
    """Run the production preflight's psql commands on the disposable DB."""

    def run(self, command, **kwargs):
        assert command[:8] == [
            "runuser", "-u", "postgres", "--", "psql", "--dbname", DATABASE,
            "--no-align",
        ], command
        return subprocess.run(
            [*COMPOSE, "exec", "-T", "db", "psql", "--quiet", "--username", "odoo",
             "--dbname", DATABASE, *command[7:]],
            check=True, text=True, **kwargs,
        )


def deployment():
    loader = importlib.machinery.SourceFileLoader(
        "deploy_addon_remote", str(ROOT / "scripts/deploy-addon-remote")
    )
    spec = importlib.util.spec_from_loader(loader.name, loader)
    module = importlib.util.module_from_spec(spec)
    loader.exec_module(module)
    return module.RemoteDeployment(
        runner=DockerPsqlRunner(), root="/", archive="/unused",
        expected_sha256="0" * 64, revision="0" * 40, database=DATABASE,
        customer="test", environment="sandbox", mode="upgrade",
    )


def check_captured_payment_guard(guard):
    """Evaluate production SQL against a captured fixture; never change a host DB."""
    before = guard._financial_snapshot()
    captured = next(row for row in before['pos_revolut_payment_operation']
                    if row['order_uuid'] == '66666666-6666-4666-8666-666666666666')
    assert captured['deployment_blocking'] and not captured['retry_safe']
    assert guard._financial_blockers() == []
    guard._verify_financial_snapshot(before)
    guard.mode = 'install'
    assert 'pos_revolut_payment_operation=1' in guard._financial_blockers()
    guard.mode = 'upgrade'
    changes = [
        "state = 'pending', provider_state = 'completed'",
        "captured_amount_minor = amount_minor + 1",
        "retry_safe = FALSE",
        "retry_safe = NULL",
    ]
    failures = [
        "state = 'created'", "state = 'dispatching_order'", "state = 'order_created'",
        "state = 'dispatching_intent'", "provider_state = 'pending'", "provider_state = NULL",
        "retry_safe = TRUE", "captured_amount_minor = 0",
        "captured_amount_minor = amount_minor - 1", "captured_amount_minor = NULL",
        "amount_minor = 0", "amount_minor = NULL", "captured_payment_created_at = NULL",
        "authorization_id = NULL", "revolut_order_id = 'bad'",
        "revolut_payment_intent_id = 'bad'", "revolut_payment_id = 'bad'", "report_run_id = 'bad'",
        "revolut_order_id = NULL", "revolut_payment_intent_id = NULL",
        "revolut_payment_id = NULL", "report_run_id = NULL",
    ]
    # Transaction rollback avoids inventing persistent financial corrections,
    # while exercising the actual PostgreSQL predicate on malformed fixture rows.
    for change in changes + failures:
        sql = f"UPDATE pos_revolut_payment_operation SET {change} WHERE id = {captured['id']};"
        transaction = ("BEGIN; ALTER TABLE pos_revolut_payment_operation DISABLE TRIGGER ALL; "
                       "ALTER TABLE pos_revolut_payment_operation ALTER COLUMN amount_minor DROP NOT NULL; ")
        constraints = guard._psql(
            "SELECT conname FROM pg_constraint WHERE conrelid = 'pos_revolut_payment_operation'::regclass AND contype = 'c'",
            "Guard fixture constraints",
        ).splitlines()
        transaction += " ".join(f'ALTER TABLE pos_revolut_payment_operation DROP CONSTRAINT "{name}";' for name in constraints)
        # NOT NULL is part of model schema, so NULL mutations target nullable fields only.
        transaction += sql
        original = guard._psql
        guard._psql = lambda query, step: original(transaction + query + '; ROLLBACK;', step)
        try:
            expected = [] if change in changes else ['pos_revolut_payment_operation=1']
            assert guard._financial_blockers() == expected, change
        finally:
            guard._psql = original
    for change in ("completed_at = NULL", "outcome = NULL", "outcome = 'unresolved'",
                   "provider_reference = 'bad'", "action = 'cancel_intent'", "action = NULL"):
        transaction = (
            "BEGIN; ALTER TABLE pos_revolut_payment_dispatch ALTER COLUMN action DROP NOT NULL; "
            "UPDATE pos_revolut_payment_dispatch SET " + change
            + f" WHERE operation_id = {captured['id']} AND action = 'create_order'; "
        )
        original = guard._psql
        guard._psql = lambda query, step: original(transaction + query + '; ROLLBACK;', step)
        try:
            assert guard._financial_blockers() == ['pos_revolut_payment_operation=1'], change
        finally:
            guard._psql = original
    guard._financial_blockers()
    guard._verify_financial_snapshot(before)
    print('DEPLOYMENT_CAPTURED_REPORT_GUARD_OK: captured-only upgrade, unsafe/null/dispatch cases blocked, unchanged ledger', flush=True)


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--legacy-addons-dir", type=Path)
    args = parser.parse_args()
    candidate_addons = os.environ.get("ODOO_REVOLUT_ADDONS_DIR", str(ROOT / "addons"))
    if args.legacy_addons_dir:
        legacy = args.legacy_addons_dir.resolve()
        if not (legacy / "pos_revolut/__manifest__.py").is_file():
            parser.error("Legacy addon directory must contain pos_revolut")
        os.environ["ODOO_REVOLUT_ADDONS_DIR"] = str(legacy)
    run("down", "--volumes", "--remove-orphans")
    try:
        run("build", "odoo")
        run("run", "--rm", "--no-deps", "--entrypoint", "python3", "odoo",
            "/opt/odoo-test-guard/verify_merchant_http_guard.py")
        run("up", "--detach", "--wait", "db")
        run("run", "--rm", "odoo", "--database", DATABASE,
            "--init", "pos_revolut", "--stop-after-init", "--workers", "0",
            "--max-cron-threads", "0", "--log-level", "warn")
        shell(SEED)
        guard = deployment()
        assert guard._financial_blockers() == [
            "pos_revolut_payment_operation=1", "pos_revolut_refund_operation=1",
        ]
        shell(SETTLE_PAYMENT)
        assert guard._financial_blockers() == ["pos_revolut_refund_operation=1"]
        shell(REFERENCE_REFUND)
        assert guard._financial_blockers() == []
        shell(REFUND_DISPATCHING)
        assert guard._financial_blockers() == ["pos_revolut_refund_operation=1"]
        shell(REFUND_UNRESOLVED)
        assert guard._financial_blockers() == []
        shell(SEED_MALFORMED_REFUND)
        assert guard._financial_blockers() == ["pos_revolut_refund_operation=1"]
        shell(FAIL_MALFORMED_REFUND)
        assert guard._financial_blockers() == []
        shell(SEED_CAPTURED_PAYMENT)
        assert guard._financial_blockers() == []
        check_captured_payment_guard(guard)
        shell(SEED_EXTERNAL)
        assert guard._financial_blockers() == []
        before = guard._financial_snapshot()
        assert any(row['state'] == 'pending' for row in before['pos_revolut_refund_operation'])
        assert any(row['deployment_blocking'] for row in before['pos_revolut_external_refund_evidence'])
        os.environ["ODOO_REVOLUT_ADDONS_DIR"] = candidate_addons
        run("run", "--rm", "odoo", "--database", DATABASE,
            "--update", "pos_revolut", "--stop-after-init", "--no-http", "--workers", "0",
            "--max-cron-threads", "0", "--log-level", "warn")
        guard._verify_financial_snapshot(before)
        assert guard._financial_blockers() == []
        print("DEPLOYMENT_PENDING_UPGRADE_PRESERVED: states, references, amounts, reservations, evidence", flush=True)
        shell(POLL_AFTER_UPGRADE)
        shell(SETTLE_REFUND)
        shell(SETTLE_EXTERNAL)
        assert guard._financial_blockers() == []
        print("Deployment guard passed: active dispatch blocked; referenced refunds/evidence preserved through upgrade")
    finally:
        run("down", "--volumes", "--remove-orphans")


if __name__ == "__main__":
    main()
