SEED_CAPTURED_PAYMENT = """
from odoo import fields
from odoo.addons.pos_revolut.models.cart_authorization import _authority_mutation
from odoo.addons.pos_revolut.models.revolut_payment_operation import _tip_evidence_write

source = env['pos.revolut.payment.operation'].search([
    ('order_uuid', '=', '22222222-2222-4222-8222-222222222222'),
], limit=1)
tip = env['product.product'].create({'name': 'Guard fixture tip', 'list_price': 0})
with _authority_mutation(env):
    authority = env['pos.revolut.cart.authorization'].create({
        'company_id': source.company_id.id, 'session_id': source.pos_session_id.id,
        'config_id': source.pos_config_id.id, 'currency_id': source.currency_id.id,
        'order_uuid': '66666666-6666-4666-8666-666666666666', 'cart_version': 1,
        'base_total_minor': 1234, 'payable_minor': 1234, 'tip_product_id': tip.id,
        'canonical': {'fixture': True}, 'native_contents': {'fixture': True},
        'fingerprint': 'fixture', 'projected_snapshot': {'fixture': True},
        'state': 'prepared', 'expires_at': fields.Datetime.now(), 'rounding': {'fixture': True},
    })
captured = env['pos.revolut.payment.operation'].create({
    'payment_method_id': source.payment_method_id.id, 'company_id': source.company_id.id,
    'pos_config_id': source.pos_config_id.id, 'pos_session_id': source.pos_session_id.id,
    'amount': source.amount, 'amount_minor': source.amount_minor,
    'currency_id': source.currency_id.id, 'currency_code': source.currency_code,
    'environment': source.environment, 'location_id': source.location_id,
    'terminal_id': source.terminal_id, 'fulfilment_type': source.fulfilment_type,
    'secret_reference': source.secret_reference,
    'state': 'unresolved', 'provider_state': 'captured', 'authorization_id': authority.id,
    'order_uuid': authority.order_uuid, 'payment_line_uuid': '66666666-6666-4666-8666-666666666667',
    'revolut_order_id': '66666666-6666-4666-8666-666666666668',
    'revolut_payment_intent_id': '66666666-6666-4666-8666-666666666669',
    'revolut_payment_id': '66666666-6666-4666-8666-666666666670',
})
with _tip_evidence_write(env):
    captured.write({'captured_amount_minor': 1234,
                    'captured_payment_created_at': fields.Datetime.now(),
                    'report_run_id': '66666666-6666-4666-8666-666666666671'})
for action, reference in [('create_order', captured.revolut_order_id),
                          ('create_intent', captured.revolut_payment_intent_id)]:
    env['pos.revolut.payment.dispatch'].create({
        'operation_id': captured.id, 'action': action, 'completed_at': fields.Datetime.now(),
        'outcome': 'succeeded', 'provider_reference': reference,
    })
assert captured.deployment_blocking and not captured.retry_safe
env.flush_all()
env.cr.execute('SELECT retry_safe FROM pos_revolut_payment_operation WHERE id = %s', [captured.id])
assert env.cr.fetchone() == (None,)  # Omitted Boolean is SQL NULL, native ORM False.
env.cr.commit()
print('DEPLOYMENT_GUARD_CAPTURED_REPORT_SEED_OK', flush=True)
"""

SETTLE_EXTERNAL = """
env['pos.revolut.refund.operation'].search([('origin', '=', 'external')]).write({'state': 'verified'})
env['pos.revolut.external.refund.evidence'].search([]).write({'resolved': True})
env.cr.commit()
"""


REFUND_DISPATCHING = """
refund = env['pos.revolut.refund.operation'].search([('origin', '=', 'odoo')], limit=1)
refund.write({'state': 'dispatching'})
