refund.write({'state': 'unresolved'})
env.cr.commit()
"""

SEED_MALFORMED_REFUND = """
source = env['pos.revolut.payment.operation'].search([
    ('order_uuid', '=', '22222222-2222-4222-8222-222222222222'),
], limit=1)
env['pos.revolut.refund.operation'].create({
    'original_operation_id': source.id, 'pos_session_id': source.pos_session_id.id,
    'order_uuid': '55555555-5555-4555-8555-555555555555',
    'payment_line_uuid': '55555555-5555-4555-8555-555555555556',
    'amount': 0.01, 'amount_minor': 1, 'return_total_minor': 1,
    'currency_id': source.currency_id.id, 'financial_snapshot': {'lines': []},
    'revolut_order_id': 'invalid-provider-reference', 'state': 'pending',
