#!/usr/bin/env python3
"""Run disposable Odoo acceptance from an exact committed release artifact."""

import argparse
import ast
import hashlib
import re
import subprocess
import tarfile
import tempfile
from pathlib import Path, PurePosixPath


REPOSITORY = Path(__file__).resolve().parents[1]
MAX_ARCHIVE_MEMBERS = 10000
MAX_ARCHIVE_BYTES = 100 * 1024 * 1024
COMPANION_ADDON = "pos_revolut_restaurant_integration"
PAIRED_SCENARIOS = ("restaurant", "restaurant-later", "upgrade", "legacy-upgrade")


class ArtifactError(RuntimeError):
    """A release artifact cannot be safely used for acceptance."""


def sha256(path):
    digest = hashlib.sha256()
    with path.open("rb") as stream:
        for chunk in iter(lambda: stream.read(1024 * 1024), b""):
            digest.update(chunk)
    return digest.hexdigest()


def extract_addons(archive, destination, addons):
    """Validate the whole Git archive before extracting the requested addons."""
    try:
        with tarfile.open(archive, "r:gz") as bundle:
            members = []
            paths = set()
            total_size = 0
            for member in bundle:
                if len(members) >= MAX_ARCHIVE_MEMBERS:
                    raise ArtifactError("Artifact has an invalid file count.")
                path = PurePosixPath(member.name)
                is_parent = member.isdir() and path.parts == ("addons",)
                is_content = (
                    len(path.parts) >= 2
                    and path.parts[0] == "addons"
                    and path.parts[1] in addons
                    and (len(path.parts) > 2 or member.isdir())
                )
                if (
                    path.is_absolute()
                    or ".." in path.parts
                    or not (is_parent or is_content)
                    or not (member.isfile() or member.isdir())
                    or path in paths
                    or member.size < 0
                ):
                    raise ArtifactError("Artifact contains an unsafe path or member type.")
                total_size += member.size
                if total_size > MAX_ARCHIVE_BYTES:
                    raise ArtifactError("Artifact is unexpectedly large.")
                paths.add(path)
                members.append(member)
            if not members:
                raise ArtifactError("Artifact has an invalid file count.")
            for addon in addons:
                manifest = f"addons/{addon}/__manifest__.py"
                if not any(member.name == manifest and member.isfile() for member in members):
                    raise ArtifactError(f"Artifact does not contain the {addon} addon manifest.")
            destination.mkdir(parents=True, exist_ok=False)
            bundle.extractall(destination, members=members, filter="data")
    except (OSError, tarfile.TarError) as error:
        raise ArtifactError("Artifact extraction failed.") from error
    return destination / "addons"


def archive_addons(revision, archive, addons):
    # Current releases place modules at the root. Retain the historical layout
    # for migration inputs, normalizing both to the guarded extraction format.
    manifests = subprocess.check_output(
        ["git", "ls-tree", "--name-only", "-r", revision, "--",
         *(f"{prefix}{addon}/__manifest__.py"
           for prefix in ("", "addons/") for addon in addons)],
        cwd=REPOSITORY, text=True,
    ).splitlines()
    layouts = [prefix for prefix in ("", "addons/")
               if all(f"{prefix}{addon}/__manifest__.py" in manifests for addon in addons)]
    if len(layouts) != 1:
        raise ArtifactError("Artifact must contain all requested addons in one unambiguous layout.")
    prefix = layouts[0]
    subprocess.run(
        ["git", "archive", "--format=tar.gz", "--output", str(archive),
         *(["--prefix=addons/"] if not prefix else []),
         revision, "--", *(f"{prefix}{addon}" for addon in addons)],
        cwd=REPOSITORY, check=True,
    )


def verify_matching_versions(release, addons):
    versions = []
    try:
        for addon in addons:
            manifest = (release / addon / "__manifest__.py").read_text()
            versions.append(ast.literal_eval(manifest)["version"])
    except (OSError, SyntaxError, ValueError, TypeError, KeyError) as error:
        raise ArtifactError("Cannot read addon versions from the artifact.") from error
    base, companion = versions
    if not isinstance(base, str) or not base or base != companion:
        raise ArtifactError("POS Revolut and Restaurant companion versions must match.")


def has_companion(revision):
    paths = (f"{COMPANION_ADDON}/__manifest__.py", f"addons/{COMPANION_ADDON}/__manifest__.py")
    return bool(subprocess.check_output(
        ["git", "ls-tree", "-r", "--name-only", revision, "--", *paths],
        cwd=REPOSITORY,
    ))


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--revision", required=True)
    parser.add_argument("--scenario", choices=(
        "retail", "restaurant", "restaurant-later", "retail-with-restaurant",
        "upgrade", "legacy-upgrade", "migration",
    ), required=True)
    parser.add_argument("--migration-from", help="Full SHA of the release to install before upgrading")
    parser.add_argument("--test-tags", help="Override acceptance selection")
    args = parser.parse_args()
    legacy = args.scenario in {"migration", "legacy-upgrade"}
    if (legacy or args.scenario == "upgrade") and not args.migration_from:
        parser.error(f"--scenario {args.scenario} requires --migration-from")
    if args.migration_from and not re.fullmatch(r"[0-9a-f]{40}", args.migration_from):
        parser.error("--migration-from must be a full commit SHA")
    if not re.fullmatch(r"[0-9a-f]{40}", args.revision):
        parser.error("--revision must be a full commit SHA")
    for option, revision in (("--revision", args.revision),
                             ("--migration-from", args.migration_from)):
        if revision is None:
            continue
        try:
            resolved = subprocess.check_output(
                ["git", "rev-parse", "--verify", f"{revision}^{{commit}}"],
                cwd=REPOSITORY, text=True, stderr=subprocess.PIPE,
            ).strip()
        except subprocess.CalledProcessError:
            parser.error(f"{option} is not an available commit")
        if resolved != revision:
            parser.error(f"{option} did not resolve to the exact commit")

    scenario = args.scenario
    if scenario == "migration" and has_companion(args.revision):
        scenario = "legacy-upgrade"

    with tempfile.TemporaryDirectory(prefix="pos-revolut-delivered-") as temporary:
        root = Path(temporary)
        archive = root / "release.tar.gz"
        try:
            addons = ("pos_revolut",)
            if scenario in PAIRED_SCENARIOS:
                addons += (COMPANION_ADDON,)
            archive_addons(args.revision, archive, addons)
            release = extract_addons(archive, root / "release", addons)
            if COMPANION_ADDON in addons:
                verify_matching_versions(release, addons)
        except ArtifactError as error:
            parser.exit(1, f"{parser.prog}: {error}\n")
        legacy_args = []
        if args.migration_from:
            legacy_archive = root / "legacy.tar.gz"
            legacy_addons = ("pos_revolut", "pos_revolut_restaurant") if legacy else ("pos_revolut",)
            try:
                archive_addons(args.migration_from, legacy_archive, legacy_addons)
                legacy_root = extract_addons(legacy_archive, root / "legacy", legacy_addons)
            except ArtifactError as error:
                parser.exit(1, f"{parser.prog}: {error}\n")
            legacy_args = ["--legacy-addons-dir", str(legacy_root)]
        print(f"Artifact revision: {args.revision}", flush=True)
        print(f"Artifact SHA256: {sha256(archive)}", flush=True)
        test_args = ["--test-tags", args.test_tags] if args.test_tags is not None else []
        subprocess.run(
            [str(REPOSITORY / "scripts" / "test-addon"),
             "--addons-dir", str(release), *legacy_args,
             "--delivered-scenario", scenario, *test_args],
            cwd=REPOSITORY, check=True,
        )


if __name__ == "__main__":
    main()
