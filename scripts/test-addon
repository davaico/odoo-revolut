#!/usr/bin/env bash
set -euo pipefail

repository_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
source "$repository_root/scripts/odoo-runtime"
project_name="${ODOO_REVOLUT_TEST_PROJECT:-odoo-revolut-tests}"
database_name="odoo_revolut_tests"
test_tags="/pos_revolut"
explicit_test_tags=false
verify_install_upgrade=false
delivered_scenario=""
legacy_addons_dir=""
migration_addons_dir=""

while (($#)); do
    case "$1" in
        --test-tags)
            test_tags="$2"
            explicit_test_tags=true
            shift 2
            ;;
        --verify-install-upgrade)
            verify_install_upgrade=true
            shift
            ;;
        --delivered-scenario)
            delivered_scenario="$2"
            shift 2
            ;;
        --addons-dir)
            export ODOO_REVOLUT_ADDONS_DIR="$(realpath "$2")"
            shift 2
            ;;
        --legacy-addons-dir)
            legacy_addons_dir="$(realpath "$2")"
            shift 2
            ;;
        *)
            echo "Unknown argument: $1" >&2
            exit 2
            ;;
    esac
done

if [[ "$delivered_scenario" != "" && "$delivered_scenario" != retail && "$delivered_scenario" != migration ]]; then
    echo "--delivered-scenario must be retail or migration" >&2
    exit 2
fi
if [[ "$delivered_scenario" == migration && -z "$legacy_addons_dir" ]]; then
    echo "Migration acceptance requires --legacy-addons-dir" >&2
    exit 2
fi
if [[ "$delivered_scenario" == migration && "$ODOO_REVOLUT_ODOO_MAJOR" != 19 ]]; then
    echo "Migration acceptance exercises Odoo 19 history; use ODOO_REVOLUT_ODOO_MAJOR=19 with the Odoo 19 addon" >&2
    exit 2
fi

compose=(docker compose --project-name "$project_name" --file "$repository_root/compose.yaml")

cleanup() {
    "${compose[@]}" down --volumes --remove-orphans >/dev/null 2>&1 || true
    if [[ -n "$migration_addons_dir" ]]; then
        rm -rf -- "$migration_addons_dir"
    fi
}
trap cleanup EXIT

cleanup
"${compose[@]}" build odoo
"${compose[@]}" up --detach --wait db

installed_version="$(
    "${compose[@]}" run --rm --no-deps --entrypoint dpkg-query odoo \
        --show --showformat='${Version}' odoo
)"
if [[ "$installed_version" != "$ODOO_REVOLUT_ODOO_VERSION" ]]; then
    echo "Expected Odoo $ODOO_REVOLUT_ODOO_VERSION, found $installed_version" >&2
    exit 1
fi

# HttpCase otherwise skips every browser tour when this dependency is missing.
"${compose[@]}" run --rm --no-deps --entrypoint python3 odoo \
    -c 'import websocket'
"${compose[@]}" run --rm --no-deps --entrypoint python3 odoo \
    /opt/odoo-test-guard/verify_merchant_http_guard.py

run_odoo() {
    "${compose[@]}" run --rm odoo \
        --database "$database_name" \
        --stop-after-init \
        --workers 0 \
        --log-level warn \
        --log-handler odoo.tests.result:INFO \
        "$@"
}

native_install_phase() {
    "${compose[@]}" run --rm -T --entrypoint odoo odoo shell \
        --database "$database_name" --db_host db --db_user odoo \
        --db_password odoo --no-http --max-cron-threads 0 \
        --shell-interface python --log-level warn \
        < "${ODOO_REVOLUT_ADDONS_DIR:-$repository_root/addons}/pos_revolut/tests/$1"
}

module_state() {
    local module="$1"
    "${compose[@]}" exec -T db psql -U odoo -d "$database_name" -Atc \
        "SELECT COALESCE((SELECT state FROM ir_module_module WHERE name = '$module'), 'absent')"
}

require_state() {
    local module="$1" expected="$2" actual
    actual="$(module_state "$module")"
    if [[ "$expected" == not-installed && ( "$actual" == absent || "$actual" == uninstalled ) ]]; then
        return
    fi
    if [[ "$actual" != "$expected" ]]; then
        echo "Expected $module to be $expected, found $actual" >&2
        exit 1
    fi
}

consolidation_tags="pos_revolut_restaurant,/pos_revolut:TestRevolutRetailPosStarts,/pos_revolut:TestRevolutVerifiedCheckout.test_cash_and_bank_still_checkout_without_revolut_dispatch,/pos_revolut:TestRestaurantConsolidation"
if [[ "$explicit_test_tags" == true ]]; then
    consolidation_tags="$test_tags"
fi

if [[ "$delivered_scenario" == retail ]]; then
    run_odoo --init pos_revolut --test-tags "$consolidation_tags"
    require_state pos_revolut installed
    require_state pos_restaurant installed
    require_state pos_revolut_restaurant absent
elif [[ "$delivered_scenario" == migration ]]; then
    delivered_addons_dir="$ODOO_REVOLUT_ADDONS_DIR"
    for legacy_mode in retail restaurant; do
        database_name="odoo_revolut_${legacy_mode}_migration"
        export ODOO_REVOLUT_ADDONS_DIR="$legacy_addons_dir"
        legacy_modules=pos_revolut
        if [[ "$legacy_mode" == restaurant ]]; then
            legacy_modules+=,pos_restaurant
        fi
        run_odoo --init "$legacy_modules"
        require_state pos_revolut installed
        if [[ "$legacy_mode" == restaurant ]]; then
            require_state pos_revolut_restaurant installed
        else
            require_state pos_revolut_restaurant not-installed
        fi
        # Match deployment: retain legacy assets until the upgrade retires them.
        migration_addons_dir="$(mktemp -d /tmp/revolut-consolidation-addons.XXXXXX)"
        cp -R -- "$delivered_addons_dir/pos_revolut" "$migration_addons_dir/"
        cp -R -- "$legacy_addons_dir/pos_revolut_restaurant" "$migration_addons_dir/"
        chmod -R u+w "$migration_addons_dir"
        chmod a+rx "$migration_addons_dir"
        export ODOO_REVOLUT_ADDONS_DIR="$migration_addons_dir"
        run_odoo --update pos_revolut --test-tags "$consolidation_tags"
        require_state pos_revolut installed
        require_state pos_restaurant installed
        require_state pos_revolut_restaurant absent
        export ODOO_REVOLUT_ADDONS_DIR="$delivered_addons_dir"
        rm -rf -- "$migration_addons_dir"
        migration_addons_dir=""
        run_odoo --update pos_revolut --test-tags "$consolidation_tags"
        require_state pos_revolut_restaurant absent
    done
else
    if [[ "$verify_install_upgrade" == true && "$ODOO_REVOLUT_ODOO_MAJOR" == 18 ]]; then
        run_odoo --init point_of_sale,pos_restaurant
        native_install_phase native_install_seed.py
    fi
    run_odoo \
        --init pos_revolut \
        --test-tags "$test_tags"
    if [[ "$verify_install_upgrade" == true ]]; then
        require_state pos_restaurant installed
        require_state pos_revolut_restaurant absent
        if [[ "$ODOO_REVOLUT_ODOO_MAJOR" == 18 ]]; then
            native_install_phase native_install_verify.py
            native_install_phase candidate_update_seed.py
        fi
        run_odoo \
            --update pos_revolut \
            --test-tags "$test_tags"
        require_state pos_revolut_restaurant absent
        if [[ "$ODOO_REVOLUT_ODOO_MAJOR" == 18 ]]; then
            native_install_phase native_install_verify.py
            native_install_phase candidate_update_verify.py
        fi
    fi
fi
