#!/usr/bin/env bash
set -euo pipefail

repository_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
project_name="${ODOO_REVOLUT_TEST_PROJECT:-odoo-revolut-tests}"
database_name="odoo_revolut_tests"
test_tags="/pos_revolut"
verify_install_upgrade=false
verify_delivered_release=false
base_only_dir=""

while (($#)); do
    case "$1" in
        --test-tags)
            test_tags="$2"
            shift 2
            ;;
        --verify-install-upgrade)
            verify_install_upgrade=true
            shift
            ;;
        --verify-delivered-release)
            verify_delivered_release=true
            shift
            ;;
        --addons-dir)
            export ODOO_REVOLUT_ADDONS_DIR="$(realpath "$2")"
            shift 2
            ;;
        --base-only-dir)
            base_only_dir="$(realpath "$2")"
            shift 2
            ;;
        *)
            echo "Unknown argument: $1" >&2
            exit 2
            ;;
    esac
done

if [[ "$verify_delivered_release" == true && -z "$base_only_dir" ]]; then
    echo "--verify-delivered-release requires --base-only-dir" >&2
    exit 2
fi

compose=(docker compose --project-name "$project_name" --file "$repository_root/compose.yaml")

cleanup() {
    "${compose[@]}" down --volumes --remove-orphans >/dev/null 2>&1 || true
}
trap cleanup EXIT

cleanup
"${compose[@]}" build odoo
"${compose[@]}" up --detach --wait db

installed_version="$(
    "${compose[@]}" run --rm --no-deps --entrypoint dpkg-query odoo \
        --show --showformat='${Version}' odoo
)"
if [[ "$installed_version" != "19.0.20260908" ]]; then
    echo "Expected Odoo 19.0.20260908, found $installed_version" >&2
    exit 1
fi

# HttpCase otherwise skips every browser tour when this dependency is missing.
"${compose[@]}" run --rm --no-deps --entrypoint python3 odoo \
    -c 'import websocket'
"${compose[@]}" run --rm --no-deps --entrypoint python3 odoo \
    /opt/odoo-test-guard/verify_merchant_http_guard.py

run_odoo() {
    "${compose[@]}" run --rm odoo \
        --database "$database_name" \
        --stop-after-init \
        --workers 0 \
        --log-level warn \
        --log-handler odoo.tests.result:INFO \
        "$@"
}

run_odoo \
    --init pos_revolut \
    --test-tags "$test_tags"

if [[ "$verify_install_upgrade" == true ]]; then
    run_odoo \
        --update pos_revolut \
        --test-tags "$test_tags"
    run_odoo --init pos_restaurant
    run_odoo \
        --update pos_revolut \
        --test-tags pos_revolut_restaurant
fi

module_state() {
    local module="$1"
    "${compose[@]}" exec -T db psql -U odoo -d "$database_name" -Atc \
        "SELECT COALESCE((SELECT state FROM ir_module_module WHERE name = '$module'), 'absent')"
}

require_state() {
    local module="$1" expected="$2" actual
    actual="$(module_state "$module")"
    if [[ "$expected" == not-installed && ( "$actual" == absent || "$actual" == uninstalled ) ]]; then
        return
    fi
    if [[ "$actual" != "$expected" ]]; then
        echo "Expected $module to be $expected, found $actual" >&2
        exit 1
    fi
}

if [[ "$verify_delivered_release" == true ]]; then
    require_state pos_revolut installed
    require_state pos_revolut_restaurant not-installed
    run_odoo --update pos_revolut --test-tags /pos_revolut
    run_odoo --init pos_restaurant
    require_state pos_revolut_restaurant installed
    run_odoo --update pos_revolut,pos_revolut_restaurant \
        --test-tags pos_revolut_restaurant

    database_name="odoo_revolut_base_only_migration"
    delivered_addons_dir="$ODOO_REVOLUT_ADDONS_DIR"
    export ODOO_REVOLUT_ADDONS_DIR="$base_only_dir"
    run_odoo --init pos_revolut,pos_restaurant
    require_state pos_revolut installed
    require_state pos_restaurant installed
    require_state pos_revolut_restaurant absent
    export ODOO_REVOLUT_ADDONS_DIR="$delivered_addons_dir"
    run_odoo --update pos_revolut --init pos_revolut_restaurant \
        --test-tags pos_revolut_restaurant
    require_state pos_revolut_restaurant installed
    run_odoo --update pos_revolut,pos_revolut_restaurant \
        --test-tags pos_revolut_restaurant
fi
