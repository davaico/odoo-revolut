#!/usr/bin/env bash
# Preserve the installed Odoo 18 environment authorities across ticket #77.
set -euo pipefail

repository_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
export ODOO_REVOLUT_ODOO_MAJOR=18
source "$repository_root/scripts/odoo-runtime"
project_name="${ODOO_REVOLUT_TEST_PROJECT:-odoo-revolut-company-credential-upgrade}"
database_name="odoo_revolut_company_credential_upgrade"
old_revision="bcc2f9395a931fae9f90e3d8979165ae2272e293"
compose_file="${ODOO_REVOLUT_COMPOSE_FILE:-$repository_root/compose.yaml}"
compose=(docker compose --project-name "$project_name" --file "$compose_file")
old_tree="$(mktemp -d /tmp/revolut-company-credential-upgrade.XXXXXX)"
chmod a+rx "$old_tree"

cleanup() {
    "${compose[@]}" down --volumes --remove-orphans >/dev/null 2>&1 || true
    rm -rf -- "$old_tree"
}
trap cleanup EXIT

git -C "$repository_root" archive --format=tar --output="$old_tree/addons.tar" "$old_revision" pos_revolut
tar -xf "$old_tree/addons.tar" -C "$old_tree"
export ODOO_REVOLUT_ADDONS_DIR="$old_tree"
"${compose[@]}" down --volumes --remove-orphans
"${compose[@]}" build odoo
installed_version="$("${compose[@]}" run --rm --no-deps --entrypoint dpkg-query odoo \
    --show --showformat='${Version}' odoo)"
if [[ "$installed_version" != "$ODOO_REVOLUT_ODOO_VERSION" ]]; then
    echo "Expected Odoo $ODOO_REVOLUT_ODOO_VERSION, found $installed_version" >&2
    exit 1
fi
"${compose[@]}" run --rm --no-deps --entrypoint python3 odoo \
    /opt/odoo-test-guard/verify_merchant_http_guard.py
"${compose[@]}" up --detach --wait db

run_odoo() {
    "${compose[@]}" run --rm odoo --database "$database_name" \
        --stop-after-init --workers 0 --max-cron-threads 0 --log-level warn "$@"
}

shell_phase() {
    "${compose[@]}" run --rm -T --entrypoint odoo odoo shell \
        --database "$database_name" --db_host db --db_user odoo --db_password odoo \
        --no-http --max-cron-threads 0 --shell-interface python --log-level warn \
        < "$repository_root/pos_revolut/tests/$1"
}

run_odoo --init pos_revolut
shell_phase company_credential_upgrade_seed.py
export ODOO_REVOLUT_ADDONS_DIR="$repository_root"
run_odoo --update pos_revolut
shell_phase company_credential_upgrade_verify.py
echo "Odoo 18 company credential upgrade preserved environment authorities and financial history"
