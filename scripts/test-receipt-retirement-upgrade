#!/usr/bin/env bash
set -euo pipefail

repository_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
project_name="${ODOO_REVOLUT_TEST_PROJECT:-odoo-revolut-receipt-retirement}"
database_name="odoo_revolut_receipt_retirement"
old_revision="83a7b2484ee16adcacc16e336d1c6e53e8d5508d"
old_tree="$(mktemp -d)"
migration_addons_dir=""
compose=(docker compose --project-name "$project_name" --file "$repository_root/compose.yaml")

cleanup() {
    docker rm --force "$project_name-native-reports" >/dev/null 2>&1 || true
    "${compose[@]}" down --volumes --remove-orphans >/dev/null 2>&1 || true
    rm -rf "$old_tree"
    if [[ -n "$migration_addons_dir" ]]; then
        rm -rf -- "$migration_addons_dir"
    fi
}
trap cleanup EXIT

git -C "$repository_root" archive "$old_revision" addons | tar -x -C "$old_tree"
export ODOO_REVOLUT_ADDONS_DIR="$old_tree/addons"
"${compose[@]}" down --volumes --remove-orphans
"${compose[@]}" build odoo
installed_version="$(
    "${compose[@]}" run --rm --no-deps --entrypoint dpkg-query odoo \
        --show --showformat='${Version}' odoo
)"
if [[ "$installed_version" != "19.0.20260908" ]]; then
    echo "Expected Odoo 19.0.20260908, found $installed_version" >&2
    exit 1
fi
"${compose[@]}" run --rm --no-deps --entrypoint python3 odoo \
    /opt/odoo-test-guard/verify_merchant_http_guard.py
"${compose[@]}" up --detach --wait db
"${compose[@]}" run --rm odoo --database "$database_name" --init pos_revolut \
    --stop-after-init --workers 0 --max-cron-threads 0 --log-level warn

shell_phase() {
    "${compose[@]}" run --rm -T --entrypoint odoo odoo shell \
        --database "$database_name" --db_host db --db_user odoo \
        --db_password odoo --no-http --max-cron-threads 0 \
        --shell-interface python --log-level warn \
        < "$repository_root/addons/pos_revolut/tests/$1"
}

shell_phase receipt_retirement_seed.py
# Match deployment and the consolidation runner: keep the legacy asset-only
# bridge available until the module upgrade has retired its registration.
migration_addons_dir="$(mktemp -d /tmp/revolut-receipt-upgrade-addons.XXXXXX)"
cp -R -- "$repository_root/addons/pos_revolut" "$migration_addons_dir/"
cp -R -- "$old_tree/addons/pos_revolut_restaurant" "$migration_addons_dir/"
chmod -R u+w "$migration_addons_dir"
chmod a+rx "$migration_addons_dir"
export ODOO_REVOLUT_ADDONS_DIR="$migration_addons_dir"
"${compose[@]}" run --rm odoo --database "$database_name" --update pos_revolut \
    --stop-after-init --workers 0 --max-cron-threads 0 --log-level warn
export ODOO_REVOLUT_ADDONS_DIR="$repository_root/addons"
rm -rf -- "$migration_addons_dir"
migration_addons_dir=""
# Serve native report assets from a separate normal Odoo process. Forced PDF
# rendering inside Odoo's shared test cursor can deadlock its own HTTP assets.
"${compose[@]}" run --rm --detach --use-aliases \
    --name "$project_name-native-reports" odoo \
    --database "$database_name" --workers 0 --max-cron-threads 0 --log-level warn
shell_phase receipt_retirement_verify.py
echo "Receipt retirement upgrade preserves history and disables standalone documents"
