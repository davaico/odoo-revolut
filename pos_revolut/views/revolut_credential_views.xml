<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_revolut_merchant_credential_list" model="ir.ui.view">
        <field name="name">pos.revolut.merchant.credential.list</field>
        <field name="model">pos.revolut.merchant.credential</field>
        <field name="arch" type="xml">
            <list edit="0" delete="0">
                <field name="company_id"/>
                <field name="environment"/>
                <field name="secret_reference"/>
                <field name="source"/>
                <field name="revoked"/>
            </list>
        </field>
    </record>
    <record id="view_revolut_merchant_credential_form" model="ir.ui.view">
        <field name="name">pos.revolut.merchant.credential.form</field>
        <field name="model">pos.revolut.merchant.credential</field>
        <field name="arch" type="xml">
            <form delete="0">
                <header>
                    <button name="action_rotate" type="object" string="Rotate Credential" invisible="not id"/>
                </header>
                <sheet>
                    <group>
                        <field name="company_id" readonly="id"/>
                        <field name="environment" readonly="id"/>
                        <field name="secret_reference" readonly="id"/>
                        <field name="source" readonly="id"/>
                        <field name="secret_key" password="True" invisible="id or source != 'database'"
                               required="not id and source == 'database'" groups="base.group_system"/>
                        <field name="revoked" invisible="not id"/>
                    </group>
                    <div class="alert alert-warning" role="alert">
                        Database keys are stored in this database and its backups. Masking is not encryption.
                        Rotation creates a new reference; retain the original key for pending payments and historical refunds.
                        Revoking it blocks recovery and refunds that require that key.
                    </div>
                </sheet>
            </form>
        </field>
    </record>
    <record id="action_revolut_merchant_credential" model="ir.actions.act_window">
        <field name="name">Revolut Merchant Authorities</field>
        <field name="res_model">pos.revolut.merchant.credential</field>
        <field name="view_mode">list,form</field>
    </record>
    <menuitem id="menu_revolut_merchant_credential"
              name="Revolut Merchant Authorities"
              parent="point_of_sale.menu_point_of_sale"
              action="action_revolut_merchant_credential"
              groups="base.group_system" sequence="42"/>
</odoo>
