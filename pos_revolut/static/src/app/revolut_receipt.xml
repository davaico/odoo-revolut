<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="pos_revolut.OrderReceipt" t-inherit="point_of_sale.OrderReceipt" t-inherit-mode="extension">
        <xpath expr="//pre[@t-esc='line.ticket']" position="attributes">
            <!-- Keep every reference character while allowing narrow paper to
                 wrap it. Other terminals may depend on fixed-width tickets. -->
            <attribute name="t-att-style">line.payment_method_id.use_payment_terminal === 'revolut' ? 'white-space: pre-wrap; overflow-wrap: anywhere;' : undefined</attribute>
        </xpath>
    </t>
</templates>
