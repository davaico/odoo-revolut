<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="rule_revolut_cart_company_manager" model="ir.rule">
        <field name="name">Revolut cart authority in allowed companies</field>
        <field name="model_id" ref="model_pos_revolut_cart_authorization"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('point_of_sale.group_pos_manager'))]"/>
    </record>
