<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_external_refund_evidence_list" model="ir.ui.view">
        <field name="name">pos.revolut.external.refund.evidence.list</field>
        <field name="model">pos.revolut.external.refund.evidence</field>
        <field name="arch" type="xml">
            <list create="0" edit="0" delete="0" decoration-warning="not resolved">
                <field name="create_date"/><field name="original_order_id"/>
                <field name="provider_order_id"/><field name="related_order_id"/>
                <field name="amount_minor"/><field name="currency_code"/><field name="reason"/>
                <field name="resolved"/><field name="blocks_financial_capacity"/><field name="deployment_blocking"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>
    <record id="view_external_refund_evidence_form" model="ir.ui.view">
        <field name="name">pos.revolut.external.refund.evidence.form</field>
        <field name="model">pos.revolut.external.refund.evidence</field>
        <field name="arch" type="xml">
            <form create="0" edit="0" delete="0">
                <sheet>
                    <group>
                        <field name="provider_order_id"/><field name="related_order_id"/>
                        <field name="original_operation_id"/><field name="original_order_id"/>
                        <field name="amount_minor"/><field name="currency_code"/>
                        <field name="reason"/><field name="resolved"/><field name="blocks_financial_capacity"/><field name="deployment_blocking"/>
                        <field name="create_date"/><field name="write_date"/>
                        <field name="company_id" groups="base.group_multi_company"/>
                    </group>
                    <p>This provider refund or discovery window requires investigation. Reported details do not establish a payment association or authorize another refund. Server reconciliation resolves this evidence only after an authoritative matching read.</p>
                    <p>Unrelated source evidence remains visible, but does not block integration refunds after an authoritative read establishes its parent is absent from all integration payment records.</p>
                    <p>Review the full provider references with an administrator or Revolut support. Product returns, inventory, cash reimbursement and accounting corrections require separate manager work.</p>
                </sheet>
            </form>
        </field>
    </record>
    <record id="view_external_refund_evidence_search" model="ir.ui.view">
        <field name="name">pos.revolut.external.refund.evidence.search</field>
        <field name="model">pos.revolut.external.refund.evidence</field>
        <field name="arch" type="xml">
            <search>
                <field name="provider_order_id"/><field name="related_order_id"/><field name="original_order_id"/>
                <filter name="unresolved" string="Needs Investigation" domain="[('resolved', '=', False)]"/>
                <filter name="resolved" string="Resolved" domain="[('resolved', '=', True)]"/>
            </search>
        </field>
    </record>
    <record id="action_external_refund_evidence" model="ir.actions.act_window">
        <field name="name">Revolut Refund Discovery Evidence</field>
        <field name="res_model">pos.revolut.external.refund.evidence</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_unresolved': 1}</field>
    </record>
    <menuitem id="menu_external_refund_evidence" name="Revolut Refund Discovery Evidence" parent="point_of_sale.menu_point_of_sale" action="action_external_refund_evidence" groups="point_of_sale.group_pos_manager" sequence="42"/>
</odoo>
