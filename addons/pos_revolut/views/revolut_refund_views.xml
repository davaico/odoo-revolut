<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_revolut_refund_list" model="ir.ui.view">
        <field name="name">pos.revolut.refund.operation.list</field>
        <field name="model">pos.revolut.refund.operation</field>
        <field name="arch" type="xml">
            <list create="0" edit="0" delete="0" decoration-danger="state == 'failed'" decoration-warning="state in ('dispatching', 'pending', 'unresolved')">
                <field name="create_date"/><field name="original_order_id"/><field name="pos_order_id"/>
                <field name="amount"/><field name="currency_id"/><field name="state"/>
                <field name="origin"/><field name="native_reconciliation_status"/>
                <field name="revolut_order_id"/><field name="related_order_id"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>
    <record id="view_revolut_refund_form" model="ir.ui.view">
        <field name="name">pos.revolut.refund.operation.form</field>
        <field name="model">pos.revolut.refund.operation</field>
        <field name="arch" type="xml">
            <form create="0" edit="0" delete="0">
                <header>
                    <button name="action_check_status" type="object" string="Check status" class="btn-primary" invisible="state in ('verified', 'failed')"/>
                    <button name="action_recover_return" type="object" string="Recover Odoo return" class="btn-primary" groups="point_of_sale.group_pos_manager" invisible="origin != 'odoo' or state != 'verified' or pos_order_id"/>
                    <button name="action_acknowledge_native_reconciliation" type="object" string="Mark native work handled separately" groups="point_of_sale.group_pos_manager" invisible="origin != 'external' or state != 'verified' or native_reconciliation_status != 'outstanding'" confirm="Confirm that you have separately handled any required product return, accounting correction and cash adjustment. This action only records your acknowledgement."/>
                </header>
                <sheet>
                    <group>
                        <field name="state"/><field name="provider_state"/><field name="local_outcome"/>
                        <field name="origin"/><field name="native_reconciliation_status"/>
                        <field name="native_reconciled_by" invisible="not native_reconciled_at"/><field name="native_reconciled_at" invisible="not native_reconciled_at"/>
                        <field name="original_operation_id"/><field name="original_order_id"/>
                        <field name="pos_order_id" invisible="origin == 'external'"/><field name="pos_session_id"/><field name="payment_method_id"/>
                        <field name="amount"/><field name="currency_id"/><field name="order_uuid" invisible="origin == 'external'"/><field name="payment_line_uuid" invisible="origin == 'external'"/>
                        <field name="revolut_order_id"/><field name="related_order_id"/><field name="idempotency_key" invisible="origin == 'external'"/>
                        <field name="dispatched_at"/><field name="verified_at"/><field name="next_reconcile_at"/>
                    </group>
                    <p invisible="origin == 'external'">Pending or uncertain refunds reserve the original payment. Check status; do not issue another refund or substitute cash. If no refund reference can be recovered, contact Revolut support with the original order and idempotency key.</p>
                    <p invisible="origin != 'odoo' or state != 'verified' or pos_order_id">If the original return is missing from POS, Recover Odoo return restores a draft with its existing completed refunds. Review and validate that draft in the original register. Recovery sends no refund request and does not finalize stock or accounting.</p>
                    <p invisible="origin != 'external'">This refund was created outside Odoo. Its financial status reserves the original card payment while pending or uncertain, and records card money returned when completed. Product returns, accounting corrections and any cash reimbursement require separate manager work. Acknowledging that work creates no return or accounting entry.</p>
                </sheet>
            </form>
        </field>
    </record>
    <record id="action_revolut_refunds" model="ir.actions.act_window">
        <field name="name">Revolut Refunds</field><field name="res_model">pos.revolut.refund.operation</field><field name="view_mode">list,form</field>
    </record>
    <menuitem id="menu_revolut_refunds" name="Revolut Refunds" parent="point_of_sale.menu_point_of_sale" action="action_revolut_refunds" groups="point_of_sale.group_pos_manager" sequence="41"/>
</odoo>
