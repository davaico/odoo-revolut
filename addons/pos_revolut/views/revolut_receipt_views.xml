<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_pos_order_revolut_receipts" model="ir.ui.view">
        <field name="name">pos.order.revolut.receipts</field>
        <field name="model">pos.order</field>
        <field name="inherit_id" ref="point_of_sale.view_pos_pos_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page name="revolut_receipts" string="Revolut Receipts" groups="point_of_sale.group_pos_user">
                    <field name="revolut_receipt_links" readonly="1" nolabel="1"/>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
