<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="paperformat_revolut_receipt" model="report.paperformat">
        <field name="name">Revolut Receipt A4</field>
        <field name="format">A4</field>
        <field name="orientation">Portrait</field>
        <field name="margin_top">15</field><field name="margin_bottom">15</field>
        <field name="margin_left">15</field><field name="margin_right">15</field>
        <field name="header_line" eval="False"/><field name="header_spacing">0</field>
        <field name="dpi">90</field>
    </record>
    <record id="action_report_revolut_payment_receipt" model="ir.actions.report">
        <field name="name">Revolut Payment Receipt</field>
        <field name="model">pos.revolut.payment.operation</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">pos_revolut.report_revolut_payment_receipt</field>
        <field name="paperformat_id" ref="paperformat_revolut_receipt"/>
        <field name="group_ids" eval="[(4, ref('point_of_sale.group_pos_user'))]"/>
    </record>
    <record id="action_report_revolut_refund_receipt" model="ir.actions.report">
        <field name="name">Revolut Refund Receipt</field>
        <field name="model">pos.revolut.refund.operation</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">pos_revolut.report_revolut_refund_receipt</field>
        <field name="paperformat_id" ref="paperformat_revolut_receipt"/>
        <field name="group_ids" eval="[(4, ref('point_of_sale.group_pos_user'))]"/>
    </record>
    <template id="report_revolut_receipt_layout">
        <html><head><meta charset="utf-8"/></head><body><t t-out="body"/></body></html>
    </template>
    <template id="report_revolut_receipt_container">
        <html><head><meta charset="utf-8"/></head><body><main><t t-out="0"/></main></body></html>
    </template>
    <template id="report_revolut_receipt_document">
        <t t-call="pos_revolut.report_revolut_receipt_container">
            <t t-foreach="documents" t-as="document">
                <div class="article" t-att-data-oe-model="'pos.revolut.' + document['kind'] + '.operation'" t-att-data-oe-id="document['operation_id']">
                    <div class="page" style="font-family: sans-serif; font-size: 12pt; color: #222;">
                        <h1 style="font-size: 22pt;" t-out="document['title']"/>
                        <p>Generated by Odoo from verified integration records. This is a card transaction receipt, not an accounting invoice or the original Revolut terminal document.</p>
                        <h2 style="font-size: 16pt;" t-out="document['merchant']['name']"/>
                        <p t-out="document['merchant_label']"/>
                        <p t-if="document['merchant'].get('address')" t-out="document['merchant']['address']"/>
                        <p t-if="document['merchant'].get('vat')">VAT: <span t-out="document['merchant']['vat']"/></p>
                        <table style="width: 100%; margin: 20px 0; border-collapse: collapse;">
                            <tr><td style="padding: 8px;">Odoo sale reference</td><td t-out="document['sale_reference']"/></tr>
                            <tr><td style="padding: 8px;">Odoo operation order identifier</td><td t-out="document['sale_uuid']"/></tr>
                            <tr><td style="padding: 8px;">Verified transaction amount</td><td><strong t-out="document['amount']"/> <strong t-out="document['currency']"/></td></tr>
                            <tr t-if="document['terminal_tip_evidence']"><td style="padding: 8px;">Base amount</td><td><span t-out="document['base_amount']"/> <span t-out="document['currency']"/></td></tr>
                            <tr t-if="document['terminal_tip_evidence']"><td style="padding: 8px;">Customer-selected terminal tip</td><td><span t-out="document['tip_amount']"/> <span t-out="document['currency']"/></td></tr>
                            <tr><td style="padding: 8px;" t-out="'Revolut refund reference' if document['kind'] == 'refund' else 'Revolut order reference'"/><td t-out="document['revolut_order_id']"/></tr>
                            <tr t-if="document['revolut_payment_id']"><td style="padding: 8px;">Revolut payment reference</td><td t-out="document['revolut_payment_id']"/></tr>
                            <tr t-if="document['verified_at']"><td style="padding: 8px;">Verified in Odoo at (UTC)</td><td t-out="document['verified_at']"/></tr>
                            <tr t-if="not document['verified_at']"><td style="padding: 8px;" colspan="2">Verification time was not retained for this historical operation.</td></tr>
                            <tr><td style="padding: 8px;">PDF generated at (UTC)</td><td t-out="document['downloaded_at']"/></tr>
                        </table>
                        <t t-if="document['kind'] == 'refund'">
                            <h2 style="font-size: 16pt;">Original Payment</h2>
                            <p>Original Odoo sale: <span t-out="document['original_sale_reference']"/></p>
                            <p>Original Revolut order: <span t-out="document['original_order_id']"/></p>
                            <p>Original Revolut payment: <span t-out="document['original_payment_id']"/></p>
                            <p>This document confirms only this verified refund amount.</p>
                        </t>
                        <p t-else="">This document confirms only this payment tender. It does not certify that the entire Odoo sale is fully paid.</p>
                        <p>Provider transaction time and optional card details were not retained by this integration. The verification time above is a local Odoo timestamp.</p>
                    </div>
                </div>
            </t>
        </t>
    </template>
    <template id="report_revolut_payment_receipt"><t t-call="pos_revolut.report_revolut_receipt_document"/></template>
    <template id="report_revolut_refund_receipt"><t t-call="pos_revolut.report_revolut_receipt_document"/></template>
</odoo>
