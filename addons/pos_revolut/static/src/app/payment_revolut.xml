<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">
    <t t-name="pos_revolut.PaymentScreenPaymentLines" t-inherit="point_of_sale.PaymentScreenPaymentLines" t-inherit-mode="extension">
        <xpath expr="//t[@t-elif=&quot;line.payment_status == 'retry'&quot;]/div[hasclass('electronic_status')]" position="replace">
            <div class="electronic_status">
                <t t-if="line.payment_method_id.use_payment_terminal === 'revolut'" t-esc="this.revolutPaymentStatus(line)"/>
                <t t-else="">Transaction cancelled</t>
            </div>
        </xpath>
        <xpath expr="//t[@t-elif=&quot;line.payment_status == 'retry'&quot;]/div[hasclass('send_payment_request')]" position="replace">
            <div class="button send_payment_request highlight text-bg-primary" role="button" title="Send Payment Request" t-on-click="() => this.props.sendPaymentRequest(line)">
                <t t-if="line.payment_method_id.use_payment_terminal === 'revolut' and !line.uiState.revolutSnapshot?.retry_safe">Check status</t>
                <t t-else="">Retry</t>
            </div>
        </xpath>
        <xpath expr="//div[@t-if=&quot;line.payment_status == 'waitingCancel'&quot;]" position="attributes">
            <attribute name="t-if">line.payment_status == 'waitingCancel' and line.payment_method_id.use_payment_terminal !== 'revolut'</attribute>
        </xpath>
    </t>
</templates>
